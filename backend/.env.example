# Database (compose provides db service locally; Neon/Render Postgres in production)
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Authentication
SECRET_API_KEY=your-secret-key-here
DEFAULT_USER=admin
DEFAULT_EMAIL=your-email@example.com
DEFAULT_PASSWORD=ChangeMe-Only-Example!

# Project Types
DEFAULT_PROJECT_TYPE_1=Job
DEFAULT_PROJECT_TYPE_2=Personal
DEFAULT_PROJECT_TYPE_3=Freelance

# CORS (comma-separated origins) — add https://gioudi.github.io in production
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Flask Debug (set to "true" only in local development)
FLASK_DEBUG=false

# Runs schema creation + seeding on app import (used by Docker/WSGI deploys)
RUN_BOOTSTRAP=false

# Cloudinary (media uploads)
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Frontend (client/.env) — baked at build time by Vue CLI
# VUE_APP_API_BASE=https://your-api.example.com
